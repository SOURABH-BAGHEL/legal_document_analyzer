# ---------------------------------------------------------------------------
# AI-Powered Legal Document Analyzer - backend configuration
# Copy this file to backend/.env and adjust. Never commit real API keys.
# ---------------------------------------------------------------------------

# LLM provider: auto | anthropic | nvidia | openai | demo
#   auto      -> first provider with a key (Anthropic, NVIDIA, OpenAI), else demo mode
#   demo      -> rule-based demo engine (no AI, clearly labelled in the UI)
LLM_PROVIDER=auto

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_API_URL=https://api.anthropic.com

# NVIDIA hosted models (keys and model IDs: https://build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1

# Any OpenAI-compatible chat-completions API (OpenAI, or a local server such as Ollama / LM Studio).
# A localhost URL keeps document text on this machine and needs no API key.
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_JSON_MODE=true

# LLM call behaviour
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=8000

# Analysis pipeline (long documents are split into overlapping chunks)
CHUNK_SIZE_CHARS=18000
CHUNK_OVERLAP_CHARS=1200
MAX_CHUNKS=15

# Uploads
MAX_UPLOAD_SIZE_MB=20

# Storage (defaults shown; relative paths resolve from the directory uvicorn is started in)
# DATABASE_URL=sqlite:///./data/legal_analyzer.db
# STORAGE_DIR=./storage/uploads

# Server
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
